{
  "compilerOptions": {
    "target": "ES2018"
  , "module": "NodeNext"
  , "moduleResolution": "NodeNext"
  , "esModuleInterop": true
  , "strict": true
  , "noUnusedLocals": false
  , "noUnusedParameters": false
  , "rootDir": "src"
  , "types": ["*"]
  , "paths": {
      "@src/*": ["./src/*"]
    , "@non-recyclable/*": ["./src/non-recyclable/*"]
    , "@recyclable/*": ["./src/recyclable/*"]
    , "@test/*": ["./__tests__/*"]
    }
  }
}
